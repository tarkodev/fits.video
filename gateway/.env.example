# Server-only configuration. Never expose these through PUBLIC_* variables.
GATEWAY_PUBLIC_ORIGIN=https://fits.example.com
GATEWAY_UPSTREAM_URL=http://8mblocal:8001
GATEWAY_UPSTREAM_AUTH_ENABLED=false
# Required only when upstream auth is enabled:
# GATEWAY_UPSTREAM_AUTH_USER=
# GATEWAY_UPSTREAM_AUTH_PASS=
GATEWAY_STATE_PATH=/state/gateway.sqlite
GATEWAY_PORT=3000
# Trust only the isolated frontend proxy's IP/subnet, never all forwarded headers.
# GATEWAY_TRUST_PROXY=172.30.0.0/24
GATEWAY_SESSION_SECONDS=604800
GATEWAY_RECORD_SECONDS=172800
GATEWAY_MAX_UPLOAD_BYTES=2147483648
GATEWAY_MAX_UPLOADS=8
GATEWAY_MAX_UPLOADS_PER_SESSION=2
GATEWAY_MAX_ACTIVE_JOBS=32
GATEWAY_MAX_JOBS_PER_SESSION=3
GATEWAY_MAX_RECORDS=10000
GATEWAY_REQUESTS_PER_MINUTE=240
GATEWAY_SESSIONS_PER_IP_HOUR=30
GATEWAY_STREAMS_PER_SESSION=6
GATEWAY_MAX_TARGET_MB=2048
GATEWAY_UPSTREAM_TIMEOUT_MS=30000
GATEWAY_UPLOAD_TIMEOUT_MS=1800000
GATEWAY_STREAM_TIMEOUT_MS=7200000
