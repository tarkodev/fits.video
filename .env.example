# 8mb.local backend client (inlined into the bundle at build time)
PUBLIC_API_URL=https://dev-local.fits.video
PUBLIC_API_AUTH_USER=admin
PUBLIC_API_AUTH_PASS=changeme

# Web server bind. WEB_PORT is also used by docker-compose to map the
# container port to the host. Required.
WEB_HOST=0.0.0.0
WEB_PORT=8002

# Vite dev server: comma-separated list of extra hostnames allowed to
# reach the dev server (loopback always works). Use `*` to allow any.
# Required.
DEV_ALLOWED_HOSTS=*
