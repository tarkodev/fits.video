# Required 8mb.local backend client URL (inlined into the bundle at build time)
PUBLIC_API_URL=https://local.fits.video
# Required. Set to `true` only if your backend requires Basic Auth.
PUBLIC_API_AUTH_ENABLED=false
# Required only when PUBLIC_API_AUTH_ENABLED=true. These values ship inside
# the public bundle when auth is enabled.
PUBLIC_API_AUTH_USER=admin
PUBLIC_API_AUTH_PASS=changeme

# Required dev server bind host.
WEB_HOST=0.0.0.0
# Required host port. docker-compose maps this to container port 80.
WEB_PORT=8002

# Required Vite dev server allowed hosts. Use `*` to allow any host, or a
# comma-separated list of extra hostnames (loopback always works).
DEV_ALLOWED_HOSTS=*
