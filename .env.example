# API endpoint for 8mb.local backend
PUBLIC_API_URL=https://dev-local.fits.video
PUBLIC_API_AUTH_USER=admin
PUBLIC_API_AUTH_PASS=changeme

# --- Vite dev server (only consumed by `npm run dev`) -----------------------
# Override these to match your environment. Anything left commented uses
# the default in vite.config.ts.

# Port `vite dev` listens on. Default: 8002.
# DEV_PORT=8002

# Bind address. Default: 0.0.0.0 (all interfaces). Use 127.0.0.1 to keep
# the dev server local-only.
# DEV_HOST=0.0.0.0

# Comma-separated list of extra hostnames allowed to reach the dev server
# (loopback addresses always work). Use `*` to disable the host check.
# DEV_ALLOWED_HOSTS=dev.fits.video,staging.fits.video

# Public hostname the browser should use for HMR websockets. Set this only
# when the dev server sits behind a reverse proxy that terminates TLS.
# DEV_HMR_HOST=dev.fits.video

# HMR transport. `wss` when the proxy serves HTTPS, `ws` otherwise.
# DEV_HMR_PROTOCOL=wss

# Public port the browser hits for HMR (443 for HTTPS proxy, 80 for HTTP).
# DEV_HMR_CLIENT_PORT=443
