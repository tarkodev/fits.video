# Required public gateway base. / uses the same origin as the static frontend.
# API requests are /api/*; 8mb.local credentials belong only in .gateway.env.
PUBLIC_API_URL=/

# Frontend bind and published port. Select an unused port for this environment.
WEB_HOST=0.0.0.0
WEB_PORT=8080
DEV_ALLOWED_HOSTS=localhost

# Existing private Docker network used by the 8mb.local backend.
FITS_BACKEND_NETWORK=8mblocal_default
