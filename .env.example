# 8mb.local backend client (inlined into the bundle at build time)
PUBLIC_API_URL=https://local.fits.video
# Set to `true` only if your backend requires Basic Auth and you accept
# that USER/PASS will ship inside the public bundle. Default: off.
PUBLIC_API_AUTH_ENABLED=false
PUBLIC_API_AUTH_USER=admin
PUBLIC_API_AUTH_PASS=changeme

# Web server bind. WEB_PORT is also used by docker-compose to map the
# container port to the host. Required.
WEB_HOST=0.0.0.0
WEB_PORT=8002

# Docker Compose (`docker compose up`): image tag and container name on the
# host. Required. Change these if several stacks run on the same machine.
DOCKER_IMAGE_NAME=fitsvideo-dev-front
DOCKER_CONTAINER_NAME=fitsvideo-dev-front

# Vite dev server: comma-separated list of extra hostnames allowed to
# reach the dev server (loopback always works). Use `*` to allow any.
# Required.
DEV_ALLOWED_HOSTS=*
